post_install() {
  cat <<'EOF'
==> turing_unlock now loads ahead of nvidia on every boot but does nothing until
==> you opt in on the kernel command line:
==>   turing_unlock.targets=all              every unbound TU102 card
==>   turing_unlock.targets=0000:21:00.0     only these PCI addresses (comma-separated)
==> Remove the option in your bootloader to boot without the unlock.
==> See /usr/share/doc/turing-unlock/README.md.
EOF
}
