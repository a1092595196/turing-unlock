# SPDX-License-Identifier: GPL-2.0-only
# Builds from the committed HEAD of the checkout this file lives in:
#   cd packaging/arch && makepkg -si
# For a published release, point the first source at the tagged tarball.
pkgbase=turing-unlock
pkgname=(turing-unlock-dkms turing-unlock-firmware)
pkgver=2.0.0
pkgrel=2
_nv=610.43.03
_utils=nvidia-utils-$_nv-1-x86_64_v3.pkg.tar.zst
pkgdesc='Unlock full speed FP16 tensor core before the NVIDIA driver loads'
arch=('x86_64')
url=''
license=('GPL-2.0-only')
makedepends=('git' 'python' 'zstd')
options=('!strip' '!debug')
source=("$pkgbase::git+file://${startdir%/packaging/arch}"
        "https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/NVIDIA-kernel-module-source-$_nv.tar.xz"
        "https://archive.cachyos.org/archive/cachyos-v3/$_utils")
noextract=("$_utils")
sha256sums=('SKIP'
            '7e118923c7a23edc36114d63273a46e3e04e9af98695a42203e7ac2dfe9fc1dc'
            'e17e7c92eeffa178b0fe1f40eb17a47095f8fc3ce4a77bf115cf5bd5a4df86e9')

prepare() {
  cd $pkgbase
  test "$(cat VERSION)" = "$pkgver"
}

build() {
  cd $pkgbase
  python firmware/generate_v67.py "$(realpath "$srcdir/$_utils")" "$srcdir/assets"
  python firmware/extract_boot_assets.py "$srcdir/NVIDIA-kernel-module-source-$_nv" "$srcdir/assets"
}

package_turing-unlock-dkms() {
  arch=('any')
  depends=('dkms' "turing-unlock-firmware=$pkgver-$pkgrel")
  backup=('etc/mkinitcpio.conf.d/zz-turing-unlock.conf')
  conflicts=('turing-unlock-mkinitcpio')
  replaces=('turing-unlock-mkinitcpio')
  install=turing-unlock.install
  cd $pkgbase
  make DESTDIR="$pkgdir" install-dkms install-mkinitcpio
  make DESTDIR="$pkgdir" PKG=$pkgname install-licenses
}

package_turing-unlock-firmware() {
  pkgdesc='Locally generated, pinned NVIDIA 610.43.03 firmware assets for turing-unlock'
  license=('LicenseRef-NVIDIA' 'GPL-2.0-only')
  cd $pkgbase
  make DESTDIR="$pkgdir" ASSETS="$srcdir/assets" install-firmware
}
